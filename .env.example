# Gmail address that sends the messages.
GMAIL_USER=youraccount@gmail.com

# OAuth client created in Google Cloud.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth refresh token generated for the same Gmail account.
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Address that receives the internal lead notification.
INTERNAL_NOTIFICATION_EMAIL=youraccount@gmail.com

# Address that receives replies from customers.
REPLY_TO_EMAIL=youraccount@gmail.com

# Optional comma-separated additional browser origins allowed to call /api.
# The production GitHub Pages origin is already included by default.
ALLOWED_CORS_ORIGINS=

# Supabase project. The service-role key remains server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Public Supabase anon key used by the prototype account experience.
# This key is intentionally safe to expose to the browser only when Row Level
# Security policies are enabled and reviewed. Never substitute the service-role key.
SUPABASE_ANON_KEY=your-public-anon-key

# Public GrowWithHR site base used in authenticated report resend emails.
# The default is the current GitHub Pages deployment if this is omitted.
GROWWITHHR_PUBLIC_APP_URL=https://hrtechifyed.github.io/GrowwithHR-Version2

# Encryption secret for reusable Company DNA stored in the Company Workspace.
# The account-linked legacy Recovery Code is encrypted with a separate key context
# derived from this same secret. If omitted, the prototype falls back to
# REPORT_ID_ALLOCATOR_SECRET, but a separate high-entropy secret is recommended.
WORKSPACE_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Optional secret for an external retention sweep trigger. The backend also runs
# an hourly in-process sweep and a startup sweep; an external scheduler is still
# recommended for production reliability.
WORKSPACE_RETENTION_SECRET=replace-with-a-long-random-secret

# Local development only. Render supplies PORT automatically.
PORT=3000
