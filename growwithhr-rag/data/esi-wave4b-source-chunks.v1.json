":1,"pageEnd":3,"priority":100,"reasonCodes":["ESI_CEILING_CONTINUATION_CONTROLS_RECORDED_SPECIALIST_REVIEW","ESI_CEILING_CONTINUATION_CONTROL_GAPS_SPECIALIST_REVIEW","ESI_CEILING_CONTINUATION_FACTS_MISSING"],"retrievalTerms":["contribution period","benefit period","saved law","transition"],"text":"The consolidated General Regulations are retained only as a saved-law candidate for contribution-period definitions. Prospective use and transition treatment require qualified review.","contentSha256":"5d50f7eba799c02d99e9118ca3c7c02dde5ac208a335b25af0bf68739fcb7ca6"},{"chunkId":"esi-code-contribution-wave4b-001","registrySourceId":"social-security-code-2020","title":"Contribution responsibility framework","sectionReference":"Sections 29–31","pageStart":31,"pageEnd":35,"priority":100,"reasonCodes":["ESI_RATE_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","ESI_RATE_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","ESI_RATE_SOURCE_FACTS_MISSING"],"retrievalTerms":["contribution responsibility","rate source","principal employer","employee share"],"text":"The controlled Code source provides contribution responsibility context. Wave 4B verifies source controls only and does not select a rate, accept wage amounts or calculate contributions.","contentSha256":"9281728a92f2a95b3ba0e0489c33059784cd9326688d57f74d731f230408772e"},{"chunkId":"esi-central-rules-rate-wave4b-001","registrySourceId":"social-security-central-rules-2026","title":"Current ordinary contribution-rate source context","sectionReference":"Rule 19","pageStart":159,"pageEnd":160,"priority":100,"reasonCodes":["ESI_RATE_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","ESI_RATE_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","ESI_RATE_SOURCE_FACTS_MISSING"],"retrievalTerms":["ordinary contribution rate","employer source","employee source","Rule 19"],"text":"Rule 19 is retained as the current ordinary contribution-rate source context. The browser and rule catalogue do not accept percentages or perform arithmetic.","contentSha256":"30df0bf7b00c9e51e9abd0ec747684fe4bcc432bd616e5e9b57a76c156dcd0d8"},{"chunkId":"esi-legacy-rules-rate-wave4b-001","registrySourceId":"employees-state-insurance-central-rules-1950","title":"Historical rate and threshold context","sectionReference":"Former Rules 50–52","pageStart":19,"pageEnd":20,"priority":100,"reasonCodes":["ESI_RATE_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","ESI_RATE_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","ESI_RATE_SOURCE_FACTS_MISSING"],"retrievalTerms":["historical rate","historical ceiling","transition","legacy rules"],"text":"The consolidated 1950 Central Rules are retained only as historical comparison and transition context. They are not represented as prospective authority for a current rate or wage ceiling.","contentSha256":"543e6f1795050ea34bf47ed7d842a5d092c6c4ba75d3d2a45a8372d4e2fd7677"}]}