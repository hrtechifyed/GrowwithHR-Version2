ority":100,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Code on Wages","appropriate Government","Central Government","State Government"],"text":"The Code on Wages source defines an appropriate Government route and rule-making framework. Wave 5A uses that source only to verify that the correct code definition has been reviewed; it never selects Central or State jurisdiction.","contentSha256":"239dfdd735d843a98415312ecc796f437d0f8ef35a8cb2570b33c8bbc5a8f2b1"},{"chunkId":"jurisdiction-ir-code-wave5a-001","registrySourceId":"industrial-relations-code-2020","title":"Industrial Relations jurisdiction-source route","sectionReference":"Section 2 appropriate Government definition and section 99","pageStart":1,"pageEnd":1,"priority":100,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Industrial Relations Code","appropriate Government","forum","source routing"],"text":"The Industrial Relations Code contains its own appropriate Government definition and rule-making framework. The deterministic review records source readiness and escalation controls without deciding the forum, government or governing source set.","contentSha256":"99f9bdb9888c699921fa0ea32177aed4c6db300e6b7b8391c52c702dd236d441"},{"chunkId":"jurisdiction-social-security-code-wave5a-001","registrySourceId":"social-security-code-2020","title":"Social Security jurisdiction-source route","sectionReference":"Section 2 appropriate Government definition and chapter-specific framework","pageStart":8,"pageEnd":19,"priority":100,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Social Security Code","appropriate Government","chapter","source routing"],"text":"The controlled Social Security Code source provides chapter-specific appropriate Government and rule-making context. It cannot be used to infer a customer location, establishment classification or applicable government.","contentSha256":"168ec4ad8ceb42778108376fae029c60e917d57d5214648b18752c614688d5f0"},{"chunkId":"jurisdiction-oshwc-code-wave5a-001","registrySourceId":"oshwc-code-2020","title":"OSHWC jurisdiction-source route","sectionReference":"Section 2 appropriate Government definition and sections 133–135","pageStart":1,"pageEnd":1,"priority":100,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["OSHWC Code","appropriate Government","establishment","controlled industry"],"text":"The OSHWC Code provides establishment-sensitive appropriate Government and rule-making context. Wave 5A does not classify an establishment, controlled industry, mine, port, railway, contractor or other activity.","contentSha256":"27a41a8528309cacc61cf95f16dddedd46cd2e3c26c93ab8bab6647ba7043f58"},{"chunkId":"jurisdiction-wages-rules-wave5a-001","registrySourceId":"code-on-wages-central-rules-2026","title":"Code on Wages Central Rules context","sectionReference":"Central Rules, 2026","pageStart":1,"pageEnd":1,"priority":90,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Central Rules","Code on Wages","Central jurisdiction"],"text":"The Code on Wages Central Rules are retained as Central-rule source context only. Their presence does not prove that the Central Government is the appropriate Government for a customer.","contentSha256":"dc72c2db01de76493cd6e176b47f726b4dc504840c1fd9518f90d651131fe5b2"},{"chunkId":"jurisdiction-ir-rules-wave5a-001","registrySourceId":"industrial-relations-central-rules-2026","title":"Industrial Relations Central Rules context","sectionReference":"Central Rules, 2026","pageStart":1,"pageEnd":1,"priority":90,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Industrial Relations Central Rules","State rules","delegation","forum"],"text":"The Industrial Relations Central Rules are retained as Central-rule source context only. State rules, notifications, delegations and forum materials remain separate controlled dependencies.","contentSha256":"aa28ca4cc4b20640e641701d190e38d0d428a98f72cf6c79ba17f24866492817"},{"chunkId":"jurisdiction-social-security-rules-wave5a-001","registrySourceId":"social-security-central-rules-2026","title":"Social Security Central Rules context","sectionReference":"Social Security (Central) Rules, 2026","pageStart":1,"pageEnd":1,"priority":90,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Social Security Central Rules","chapter-specific","State rules"],"text":"The controlled Social Security Central Rules provide Central procedural context for the relevant chapters. They do not replace State or Union Territory materials or resolve chapter-specific jurisdiction.","contentSha256":"42bdd796004fe3b59d689195a37b64b4c35fdd2e4cff3d85e73ba85b7450f995"},{"chunkId":"jurisdiction-oshwc-rules-wave5a-001","registrySourceId":"oshwc-central-rules-2026","title":"OSHWC Central Rules context","sectionReference":"OSHWC Central Rules, 2026","pageStart":1,"pageEnd":1,"priority":90,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["OSHWC Central Rules","establishment category","State source"],"text":"The OSHWC Central Rules provide Central procedural context only. Establishment category, industry, location, activity and State source questions remain subject to qualified review.","contentSha256":"65f7c9c30185d74a5e7dc9b49e3071c5235d567d31faa14d50f26c96456a4918"},{"chunkId":"jurisdiction-ministry-concurrent-list-wave5a-001","registrySourceId":"ministry-labour-jurisdiction-2026","title":"Concurrent-list labour jurisdiction context","sectionReference":"Ministry constitutional labour-jurisdiction overview","pageStart":1,"pageEnd":1,"priority":100,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["Concurrent List","Central Government","State Government","labour jurisdiction"],"text":"The Ministry describes labour as a Concurrent List subject in which Central and State Governments may be competent. This is routing context only and cannot decide the legally appropriate Government in a customer matter.","contentSha256":"8c25de0b9d865967aabc3e248ddfe598ca46e649399935fa070adcd216819695"},{"chunkId":"jurisdiction-state-source-gap-wave5a-001","registrySourceId":"ministry-labour-jurisdiction-2026","title":"State and Union Territory source-set dependency","sectionReference":"State-source routing boundary","pageStart":1,"pageEnd":1,"priority":100,"reasonCodes":["APPROPRIATE_GOVERNMENT_SOURCE_CONTROLS_RECORDED_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_SOURCE_CONTROL_GAPS_SPECIALIST_REVIEW","APPROPRIATE_GOVERNMENT_FACTS_MISSING"],"retrievalTerms":["State Act","State rules","Union Territory","notification","delegation"],"text":"Wave 5A requires an exact State or Union Territory source set whenever a State route may be relevant. Retrieval cannot supply missing Acts, rules, amendments, notifications, delegations or effective-date evidence.","contentSha256":"455801ad94839e72875546dc2883fa5f21e05b32d986c415b96dcaefc09108c2"}]}