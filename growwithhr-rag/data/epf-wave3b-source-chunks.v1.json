-wage-ceiling-so-2702e-2026.pdf","sha256":"62dbc6c22949eed3ccd0cde11488312c4db4480623078254a558770d14cb3893","byteLength":946569,"pageCount":2},{"registrySourceId":"social-security-code-commencement-so-5319e-2025","title":"Code on Social Security commencement notification S.O. 5319(E), 2025","documentType":"Official Gazette notification","official":true,"reviewStatus":"needs-legal-review","officialUrl":"https://www.labour.gov.in/","fileName":"social-security-code-commencement-so-5319e-2025.pdf","drivePath":"GrowWithHR-RAG/01-source-documents/official/social-security/03-notifications/social-security-code-commencement-so-5319e-2025.pdf","sha256":"014ba41eba2c0beda344bf084e1bed1d6f7f6929aabdbc7b4fa25fe22bce45c5","byteLength":408295,"pageCount":2},{"registrySourceId":"social-security-code-corrigendum-so-5936e-2025","title":"Code on Social Security corrigendum S.O. 5936(E), 2025","documentType":"Official Gazette corrigendum","official":true,"reviewStatus":"needs-legal-review","officialUrl":"https://www.labour.gov.in/whats-new","fileName":"social-security-code-corrigendum-so-5936e-2025.pdf","drivePath":"GrowWithHR-RAG/01-source-documents/official/social-security/03-notifications/social-security-code-corrigendum-so-5936e-2025.pdf","sha256":"d14b088ef05a8f34c37d823b3b6fc6bd78a101e37882edc256d931e01e063a03","byteLength":560515,"pageCount":2}],"chunks":[{"chunkId":"social-security-code-epf-wage-ceiling-wave3b-001","registrySourceId":"social-security-code-2020","title":"Wage-ceiling definition context","sectionReference":"Section 2(89)","pageStart":9,"pageEnd":19,"priority":100,"reasonCodes":["EPF_WAGE_CEILING_SOURCE_RECORDED_REVIEW_REQUIRED","EPF_WAGE_CEILING_SPECIALIST_REVIEW_REQUIRED","EPF_WAGE_CEILING_FACTS_MISSING"],"retrievalTerms":["wage ceiling","statutory wage band","prior member","higher wage"],"text":"The controlled Code source provides the wage-ceiling definition context. Wave 3B accepts only a controlled wage band and prior-member or higher-wage review statuses; it never accepts employee wage amounts or decides individual membership.","contentSha256":"aeb547b968ee2130fdc6907199d660f675591d2c4e3bdcd012caa5f4470d2e1a"},{"chunkId":"social-security-wage-ceiling-wave3b-001","registrySourceId":"social-security-wage-ceiling-so-2702e-2026","title":"Controlled wage-ceiling notification","sectionReference":"S.O. 2702(E), 2026","pageStart":1,"pageEnd":2,"priority":100,"reasonCodes":["EPF_WAGE_CEILING_SOURCE_RECORDED_REVIEW_REQUIRED","EPF_WAGE_CEILING_SPECIALIST_REVIEW_REQUIRED","EPF_WAGE_CEILING_FACTS_MISSING"],"retrievalTerms":["S.O. 2702(E)","notified ceiling","wage band","EPF"],"text":"The controlled Gazette notification is retained as the wage-ceiling source identity. The product records whether that source and a controlled wage band are present but does not calculate wages or determine excluded-employee treatment.","contentSha256":"b2240653b591bb4910d83709449bfa4f827b4ca0113d9444d3dbb623b2aa8ebd"},{"chunkId":"social-security-code-epf-rate-wave3b-001","registrySourceId":"social-security-code-2020","title":"EPF contribution-rate framework","sectionReference":"Section 16 and Chapter III contribution framework","pageStart":27,"pageEnd":31,"priority":100,"reasonCodes":["EPF_RATE_BASIS_EVIDENCED_VERIFICATION_RECOMMENDED","EPF_RATE_BASIS_NOT_EVIDENCED_SPECIALIST_REVIEW","EPF_RATE_BASIS_FACTS_MISSING"],"retrievalTerms":["contribution rate","section 16","chapter III","official basis"],"text":"The controlled Code source provides the contribution-rate framework. A declared ten-percent or twelve-percent branch is processed only as a verification input and is never selected, calculated or approved by the product.","contentSha256":"5d37e6cb1a775ba968471400fc6d1b0b94aedeb469bb9ae7d2fc80b25911a002"},{"chunkId":"epf-scheme-rate-source-wave3b-001","registrySourceId":"employees-provident-funds-scheme-2026","title":"EPF Scheme rate-branch context","sectionReference":"Paragraph 18","pageStart":75,"pageEnd":78,"priority":100,"reasonCodes":["EPF_WAGE_CEILING_SOURCE_RECORDED_REVIEW_REQUIRED","EPF_WAGE_CEILING_SPECIALIST_REVIEW_REQUIRED","EPF_WAGE_CEILING_FACTS_MISSING","EPF_RATE_BASIS_EVIDENCED_VERIFICATION_RECOMMENDED","EPF_RATE_BASIS_NOT_EVIDENCED_SPECIALIST_REVIEW","EPF_RATE_BASIS_FACTS_MISSING"],"retrievalTerms":["paragraph 18","ten percent","twelve percent","higher wage","rate source"],"text":"The controlled EPF Scheme source provides rate-branch and wage-ceiling routing context. The exact S.O. 320(E) source gap remains unresolved, so all results require qualified legal verification and no contribution arithmetic is permitted.","contentSha256":"9864f39707881c7cab20992dffec5551db9fafc35996e4da35fa168a85cf6a75"},{"chunkId":"eps-scheme-membership-wave3b-001","registrySourceId":"employees-pension-scheme-2026","title":"EPS membership-routing context","sectionReference":"Paragraphs 1–8","pageStart":43,"pageEnd":47,"priority":100,"reasonCodes":["EPS_MEMBERSHIP_ROUTING_REVIEW_REQUIRED","EPS_ROUTING_SPECIALIST_REVIEW_REQUIRED","EPS_ROUTING_FACTS_MISSING"],"retrievalTerms":["EPS membership","prior member","wage band","employer diversion","higher wage"],"text":"The controlled EPS Scheme source provides membership-routing context. Wave 3B reviews controlled routing statuses and does not determine an individual's EPS membership, pension eligibility or higher-wage treatment.","contentSha256":"184926ae60d016eb4b9c2e5f03e0d570e0db80bd602f0ea344accaef91e39a6e"},{"chunkId":"eps-scheme-controls-wave3b-001","registrySourceId":"employees-pension-scheme-2026","title":"EPS pension-process controls","sectionReference":"Paragraphs 9–29","pageStart":47,"pageEnd":58,"priority":100,"reasonCodes":["EPS_CONTROL_EVIDENCED_VERIFICATION_RECOMMENDED","EPS_CONTROL_GAPS_SPECIALIST_REVIEW","EPS_CONTROL_FACTS_MISSING"],"retrievalTerms":["EPS records","employer diversion","claim control","higher wage escalation"],"text":"The controlled EPS Scheme source provides pension-process, records and claim-control context. Only organisation control statuses and evidence references are processed; completed claims, pension records and individual outcomes are prohibited.","contentSha256":"b63a2d5e4c282d5e239f4a8c5c03e9a5eba1c74f5509ccceca03283dd4e82f74"},{"chunkId":"edli-scheme-controls-wave3b-001","registrySourceId":"employees-deposit-linked-insurance-scheme-2026","title":"EDLI membership, contribution and claim controls","sectionReference":"Paragraphs 1–25","pageStart":12,"pageEnd":18,"priority":100,"reasonCodes":["EDLI_CONTROL_EVIDENCED_VERIFICATION_RECOMMENDED","EDLI_RATE_SOURCE_SPECIALIST_REVIEW","EDLI_CONTROL_FACTS_MISSING"],"retrievalTerms":["EDLI coverage","rate source","contribution control","claim control","transition"],"text":"The controlled EDLI Scheme source provides membership, contribution and claim-control context. The current EDLI rate authority remains unconfirmed, so the product does not calculate contributions or decide claims or benefits.","contentSha256":"3a0402686d33490b092775c1047435fbe981fc56b9e94cd815a96e127c19e73b"},{"chunkId":"social-security-commencement-epf-wave3b-001","registrySourceId":"social-security-code-commencement-so-5319e-2025","title":"Commencement context","sectionReference":"S.O. 5319(E), dated 21 November 2025","pageStart":1,"pageEnd":2,"priority":100,"reasonCodes":["EPF_WAGE_CEILING_SOURCE_RECORDED_REVIEW_REQUIRED","EPF_WAGE_CEILING_SPECIALIST_REVIEW_REQUIRED","EPF_WAGE_CEILING_FACTS_MISSING","EPF_RATE_BASIS_EVIDENCED_VERIFICATION_RECOMMENDED","EPF_RATE_BASIS_NOT_EVIDENCED_SPECIALIST_REVIEW","EPF_RATE_BASIS_FACTS_MISSING","EPS_MEMBERSHIP_ROUTING_REVIEW_REQUIRED","EPS_ROUTING_SPECIALIST_REVIEW_REQUIRED","EPS_ROUTING_FACTS_MISSING","EPS_CONTROL_EVIDENCED_VERIFICATION_RECOMMENDED","EPS_CONTROL_GAPS_SPECIALIST_REVIEW","EPS_CONTROL_FACTS_MISSING","EDLI_CONTROL_EVIDENCED_VERIFICATION_RECOMMENDED","EDLI_RATE_SOURCE_SPECIALIST_REVIEW","EDLI_CONTROL_FACTS_MISSING"],"retrievalTerms":["commencement","21 November 2025","Chapter III","transition"],"text":"The controlled commencement notification is retained as effective-date context. Transition and savings treatment remains subject to qualified legal review and cannot be resolved by retrieval or provider output.","contentSha256":"c4de955fc271ec8a73eaefeb9e406d70549f56d2c3a6b92687186a8df49bec63"},{"chunkId":"social-security-corrigendum-epf-wave3b-001","registrySourceId":"social-security-code-corrigendum-so-5936e-2025","title":"Corrigendum context","sectionReference":"S.O. 5936(E), dated 19 December 2025","pageStart":1,"pageEnd":2,"priority":100,"reasonCodes":["EPF_WAGE_CEILING_SOURCE_RECORDED_REVIEW_REQUIRED","EPF_WAGE_CEILING_SPECIALIST_REVIEW_REQUIRED","EPF_WAGE_CEILING_FACTS_MISSING","EPF_RATE_BASIS_EVIDENCED_VERIFICATION_RECOMMENDED","EPF_RATE_BASIS_NOT_EVIDENCED_SPECIALIST_REVIEW","EPF_RATE_BASIS_FACTS_MISSING","EPS_MEMBERSHIP_ROUTING_REVIEW_REQUIRED","EPS_ROUTING_SPECIALIST_REVIEW_REQUIRED","EPS_ROUTING_FACTS_MISSING","EPS_CONTROL_EVIDENCED_VERIFICATION_RECOMMENDED","EPS_CONTROL_GAPS_SPECIALIST_REVIEW","EPS_CONTROL_FACTS_MISSING","EDLI_CONTROL_EVIDENCED_VERIFICATION_RECOMMENDED","EDLI_RATE_SOURCE_SPECIALIST_REVIEW","EDLI_CONTROL_FACTS_MISSING"],"retrievalTerms":["corrigendum","19 December 2025","S.O. 5936(E)","S.O. 5319(E)"],"text":"The controlled corrigendum remains attached to commencement context so the original notification is not represented in isolation. Its legal effect and transition implications remain subject to specialist review.","contentSha256":"69c2f7b273cdae69c6ccba2913030266637053a98e368d5f9f1d875714253fd8"}]}