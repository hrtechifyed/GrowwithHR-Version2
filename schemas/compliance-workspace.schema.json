{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growwithhr.hrtechify.com/schemas/compliance-workspace.schema.json",
  "title": "GrowWithHR Compliance Workspace",
  "type": "object",
  "required": ["schemaVersion", "workspaceVersion", "workspaceId", "organisationName", "createdAt", "updatedAt", "tasks", "evidencePlaceholders", "calendar", "audit"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workspaceVersion": { "type": "string" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "organisationName": { "type": "string", "minLength": 1 },
    "sourceSnapshotId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "owner", "status", "dueDate", "dueDateSource", "createdAt", "updatedAt", "statusHistory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "status": { "enum": ["not-started", "in-progress", "blocked", "complete"] },
          "dueDate": { "type": "string" },
          "dueDateSource": { "enum": ["statutory", "official-guidance", "internal-target", "specialist-advice", "not-confirmed"] },
          "sourceReference": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "statusHistory": { "type": "array" }
        },
        "additionalProperties": false
      }
    },
    "evidencePlaceholders": { "type": "array" },
    "calendar": { "type": "array" },
    "audit": { "type": "array" }
  },
  "additionalProperties": false
}
