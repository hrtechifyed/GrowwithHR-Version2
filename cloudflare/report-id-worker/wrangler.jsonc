{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "growwithhr-report-id",
  "main": "src/entry-v2.mjs",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPORT_ID_REGISTRY",
        "class_name": "ReportIdRegistry"
      }
    ]
  },
  "exports": {
    "ReportIdRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
